{
  "name": "homebridge-powerview-universal",
  "displayName": "PowerView (Gen 1 & 2)",
  "type": "module",
  "version": "4.6.0",
  "description": "Hunter Douglas PowerView shades on Generation 1 and 2 hubs. Scenes, battery, tilt and top-down/bottom-up. Homebridge 1.8+ and 2.x.",
  "license": "ISC",
  "keywords": [
    "homebridge-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sunnierseattle/homebridge-powerview-universal.git"
  },
  "bugs": {
    "url": "https://github.com/sunnierseattle/homebridge-powerview-universal/issues"
  },
  "homepage": "https://github.com/sunnierseattle/homebridge-powerview-universal#readme",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^5.0.0"
  },
  "author": "sunnierseattle",
  "contributors": [
    "Scott James Remnant",
    "Owen Selles",
    "squircle12"
  ]
}
